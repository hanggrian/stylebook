    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-plugin": "5.3.1",
    "@types/sinon": "22.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "sinon": "22.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "typedoc": "0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-dom": "0.1.1"
  }
